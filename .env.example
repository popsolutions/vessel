# Huawei E9000 HMM (Hardware Management Module)
HMM_HOST=192.168.1.30
HMM_USER=root
HMM_PASSWORD=changeme

# Optional: per-blade iBMC credentials (override per blade if different)
IBMC_USER=root
IBMC_PASSWORD=changeme

# TLS verification — HMM uses self-signed cert by default
HMM_VERIFY_TLS=false

# Snapshot storage
SNAPSHOTS_DIR=./snapshots

# Web GUI target list — chassis hosts that appear in the /login
# dropdown. Comma-separated. The first entry is the pre-selected
# default. New chassis can also be added live via "+ add new chassis"
# in the GUI; they get persisted to ~/.config/vessel/targets.json
# and survive restarts without editing this file.
VESSEL_TARGETS=192.168.1.30,192.168.1.20

# Optional: where the GUI persists chassis added via "+ add new
# chassis" in the login form. Defaults to ~/.config/vessel/targets.json.
# VESSEL_TARGETS_FILE=/etc/vessel/targets.json

# Forgejo (git.pop.coop) — repo + issue tracking
GIT_HOST=git.pop.coop
GIT_OWNER=noc
GIT_REPO=huaweie9000
GIT_TOKEN=changeme
