# Huawei E9000 HMM (Hardware Management Module)
HMM_HOST=192.168.1.30
HMM_USER=root
HMM_PASSWORD=changeme

# Optional: per-blade iBMC credentials (override per blade if different)
IBMC_USER=root
IBMC_PASSWORD=changeme

# TLS verification — HMM uses self-signed cert by default
HMM_VERIFY_TLS=false

# Snapshot storage
SNAPSHOTS_DIR=./snapshots

# Forgejo (git.pop.coop) — repo + issue tracking
GIT_HOST=git.pop.coop
GIT_OWNER=noc
GIT_REPO=huaweie9000
GIT_TOKEN=changeme
