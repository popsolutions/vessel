.env
.env.local
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
dist/
build/
*.egg-info/
.idea/
.vscode/

# Snapshot payloads (configs, hashes, redfish dumps — may contain MACs/UUIDs);
# keep the tree, drop the content
snapshots/*/
!snapshots/.gitkeep

# Discovery artifacts (raw API dumps and sweep results; may contain UUIDs/MACs)
discovery/*/
discovery/*.json
!discovery/.gitkeep

# Reverse engineering artifacts — Huawei IP, do not redistribute
re/vconsole.jar
re/decompiled/
